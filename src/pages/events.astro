---
import { getImage, Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';
import Badge from '../components/brand/Badge.astro';
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import MobileCta from '../components/layout/MobileCta.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import booth from '../assets/booth.jpg';
import marketCrop from '../assets/events/andrew-market-crop.jpg';
import reelMp4 from '../assets/hero/coconut-cut-mobile.mp4?url';
import reelPoster from '../assets/hero/coconut-cut-mobile-poster.jpg';
import reelWebm from '../assets/hero/coconut-cut-mobile.webm?url';
import corporateServing from '../assets/owner/andrew-corporate-serving.jpg';
import corporate from '../assets/owner/andrew-corporate.jpg';
import cuttingCloseup from '../assets/owner/andrew-cutting-closeup.jpg';
import galaGuest from '../assets/owner/andrew-gala-guest.jpg';
import group from '../assets/owner/andrew-group.jpg';
import park from '../assets/owner/andrew-hero.jpg';
import { homeLink, instagramHandle, instagramUrl } from '../config/site';
import { eventTypes } from '../data/content';

type Post = { image: ImageMetadata; alt: string; focus?: string; video?: { mp4: string; webm: string } };

// Order alternates indoor/outdoor and close/wide shots so no row feels heavy.
const posts: Post[] = [
	{ image: booth, alt: 'The Coco Shack bar set up outside an office tower, with crates of fresh coconuts and palms' },
	{ image: reelPoster, alt: 'Video: Andrew cutting open a fresh coconut', video: { mp4: reelMp4, webm: reelWebm } },
	{ image: galaGuest, alt: 'A guest sipping from a freshly opened coconut beside the bar', focus: '38% 50%' },
	{ image: corporateServing, alt: 'Andrew serving a guest at an outdoor event, with tents and a crowd behind', focus: '62% 50%' },
	{ image: cuttingCloseup, alt: 'Andrew opening a coconut with a machete at an indoor event', focus: '52% 50%' },
	{ image: park, alt: 'Andrew holding fresh coconuts behind a Coco Shack table set up in a park', focus: '50% 60%' },
	{ image: group, alt: 'Andrew with guests in formal wear at an evening event', focus: '55% 50%' },
	{ image: marketCrop, alt: 'Andrew holding out a freshly opened coconut outdoors' },
	{ image: corporate, alt: 'Andrew behind the Coco Shack bar with a coconut in hand', focus: '50% 40%' },
];

// Full-size versions for the viewer; the grid itself loads small crops.
const slides = await Promise.all(
	posts.map(async (post) => {
		const full = await getImage({ src: post.image, widths: [720, 1080, 1600], format: 'webp', quality: 82 });
		return {
			src: full.src,
			srcset: full.srcSet.attribute,
			width: post.image.width,
			height: post.image.height,
			alt: post.alt,
			video: post.video ?? null,
		};
	}),
);

const contactHref = homeLink(Astro.url.pathname, '#contact');
---

<Layout
	title="Events | The Coco Shack"
	description="Photos from The Coco Shack's live coconut bar at weddings, corporate events, festivals and private celebrations across Toronto and the GTA."
>
	<Header />

	<main id="main" class="events-page">
		<div class="events-glow" aria-hidden="true"></div>

		<div class="profile-wrap">
			<header class="profile">
				<div class="avatar-ring">
					<Badge class="avatar" decorative />
				</div>

				<div class="profile-body">
					<p class="eyebrow">Events</p>
					<h1 class="profile-name">The Coco Shack</h1>
					<a href={instagramUrl} target="_blank" rel="noopener noreferrer" class="profile-handle link-line">
						{instagramHandle}
					</a>

					<ul class="profile-stats" aria-label="At a glance">
						<li><strong>{posts.length}</strong> posts</li>
						<li><strong>{eventTypes.length}</strong> event types</li>
						<li><strong>GTA</strong> wide</li>
					</ul>

					<p class="profile-bio">
						A live coconut bar for weddings, corporate events, festivals and private celebrations across Toronto and the GTA. Fresh
						coconuts, opened in front of your guests.
					</p>

					<div class="profile-actions">
						<Button href={contactHref} label="Book Your Event" size="sm" />
						<Button
							href={instagramUrl}
							label="Instagram"
							variant="ghost"
							size="sm"
							icon="instagram"
							target="_blank"
							rel="noopener noreferrer"
						/>
					</div>
				</div>
			</header>

			<div class="grid-tabs" aria-hidden="true">
				<span class="grid-tab"><Icon name="grid" class="h-3.5 w-3.5" strokeWidth={1.8} /> Posts</span>
			</div>

			<ul class="post-grid" aria-label="Event photos">
				{
					posts.map((post, i) => (
						<li>
							<a href={slides[i].src} class="post-tile" data-post={i} aria-label={`Open ${post.video ? 'video' : 'photo'} ${i + 1} of ${posts.length}`}>
								<Image
									src={post.image}
									alt={post.alt}
									widths={[240, 360, 520]}
									sizes="(min-width: 1000px) 312px, 33vw"
									loading={i < 6 ? 'eager' : 'lazy'}
									class="post-img"
									style={post.focus ? `object-position: ${post.focus}` : undefined}
								/>
								{post.video && (
									<span class="post-badge" aria-hidden="true">
										<Icon name="play" class="h-3.5 w-3.5" />
									</span>
								)}
							</a>
						</li>
					))
				}
			</ul>
		</div>

		<CtaBand />
	</main>

	<Footer />
	<MobileCta />

	<dialog id="post-viewer" class="viewer" aria-label="Event photos" data-lenis-prevent>
		<div class="viewer-bar">
			<p class="viewer-count" aria-live="polite"><span data-viewer-index>1</span> / {posts.length}</p>
			<button type="button" class="viewer-btn" data-viewer-close aria-label="Close" autofocus>
				<Icon name="close" class="h-5 w-5" strokeWidth={1.8} />
			</button>
		</div>

		<div class="viewer-stage" data-viewer-stage>
			<button type="button" class="viewer-btn viewer-nav viewer-prev" data-viewer-prev aria-label="Previous">
				<Icon name="chevron-left" class="h-5 w-5" strokeWidth={1.8} />
			</button>

			<figure class="viewer-figure" data-viewer-figure>
				<img class="viewer-media" data-viewer-img alt="" decoding="async" draggable="false" />
				<video class="viewer-media" data-viewer-video playsinline muted loop controls disablepictureinpicture hidden></video>
			</figure>

			<button type="button" class="viewer-btn viewer-nav viewer-next" data-viewer-next aria-label="Next">
				<Icon name="chevron-right" class="h-5 w-5" strokeWidth={1.8} />
			</button>
		</div>

		<div class="viewer-dots" aria-hidden="true">
			{posts.map(() => <span class="viewer-dot" />)}
		</div>
	</dialog>

	<script type="application/json" id="post-data" set:html={JSON.stringify(slides)} />
</Layout>

<style>
	.events-page {
		position: relative;
		overflow-x: clip;
		background: var(--color-ink-soft);
	}

	.events-glow {
		position: absolute;
		top: -12rem;
		left: 50%;
		width: min(64rem, 120vw);
		height: 38rem;
		translate: -50% 0;
		background:
			radial-gradient(40% 42% at 38% 48%, rgba(193, 128, 76, 0.14), transparent 70%),
			radial-gradient(34% 38% at 66% 52%, rgba(70, 88, 62, 0.18), transparent 70%);
		pointer-events: none;
	}

	/* Instagram's profile column is ~935px; the same narrow measure keeps the grid calm on wide screens. */
	.profile-wrap {
		position: relative;
		width: 100%;
		max-width: 62rem;
		margin-inline: auto;
		padding-top: clamp(7.5rem, 16vw, 11rem);
		padding-bottom: clamp(4.5rem, 9vw, 7rem);
		padding-left: max(1rem, env(safe-area-inset-left));
		padding-right: max(1rem, env(safe-area-inset-right));
	}

	/* ---------- Profile header ---------- */
	.profile {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		column-gap: 1.25rem;
		align-items: start;
		padding-inline: 0.25rem;
	}

	.avatar-ring {
		display: grid;
		place-items: center;
		width: 5.75rem;
		height: 5.75rem;
		padding: 3px;
		border-radius: 999px;
		background: conic-gradient(
			from 200deg,
			var(--color-clay),
			var(--color-clay-light),
			var(--color-moss-light),
			var(--color-clay)
		);
	}

	.avatar-ring :global(.avatar) {
		width: 100%;
		height: 100%;
		border-radius: 999px;
		border: 3px solid var(--color-ink-soft);
		background: var(--color-cream);
		object-fit: cover;
	}

	.profile-name {
		margin-top: 0.7rem;
		font-family: var(--font-display);
		font-size: clamp(1.6rem, 4.5vw, 2.35rem);
		font-weight: 600;
		line-height: 1.05;
		letter-spacing: -0.025em;
		color: var(--color-cream);
	}

	.profile-handle {
		display: inline-block;
		margin-top: 0.35rem;
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--color-clay-light);
	}

	.profile-stats {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.4rem;
		margin-top: 1.1rem;
		font-size: 0.9rem;
		color: var(--color-cream-dim);
	}

	.profile-stats strong {
		font-weight: 700;
		color: var(--color-cream);
	}

	.profile-bio {
		max-width: 34rem;
		margin-top: 1.1rem;
		font-size: 0.97rem;
		line-height: 1.65;
		color: var(--color-cream-dim);
	}

	.profile-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-top: 1.4rem;
	}

	/* Phones: avatar beside name/handle/stats, then bio and buttons full-width underneath — like the app. */
	@media (max-width: 639px) {
		.profile-body {
			display: contents;
		}

		.avatar-ring {
			grid-row: 1 / span 4;
			align-self: center;
			width: 5.25rem;
			height: 5.25rem;
		}

		.profile-body > .eyebrow,
		.profile-body > .profile-name,
		.profile-body > .profile-handle,
		.profile-body > .profile-stats {
			grid-column: 2;
		}

		.profile-body > .profile-name {
			margin-top: 0.5rem;
		}

		.profile-body > .profile-stats {
			margin-top: 0.75rem;
			column-gap: 1rem;
			font-size: 0.85rem;
		}

		.profile-bio,
		.profile-actions {
			grid-column: 1 / -1;
		}

		.profile-bio {
			margin-top: 1.4rem;
		}

		.profile-actions :global(.btn) {
			flex: 1;
		}
	}

	@media (min-width: 640px) {
		.profile {
			column-gap: clamp(2rem, 6vw, 4.5rem);
			align-items: center;
			padding-inline: clamp(0.5rem, 4vw, 3.5rem);
		}

		.avatar-ring {
			width: clamp(7.5rem, 16vw, 9.5rem);
			height: clamp(7.5rem, 16vw, 9.5rem);
			padding: 4px;
		}

		.avatar-ring :global(.avatar) {
			border-width: 4px;
		}
	}

	/* ---------- Tab + grid ---------- */
	.grid-tabs {
		display: flex;
		justify-content: center;
		margin-top: clamp(2.5rem, 6vw, 3.75rem);
		border-top: 1px solid rgba(246, 239, 225, 0.1);
	}

	.grid-tab {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-top: -1px;
		padding: 1rem 0.25rem;
		border-top: 1px solid var(--color-cream);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--color-cream);
	}

	.post-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 3px;
	}

	.post-tile {
		position: relative;
		display: block;
		overflow: hidden;
		aspect-ratio: 3 / 4;
		background: var(--color-panel);
		outline-offset: 3px;
	}

	.post-img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: scale 1.1s var(--ease-premium);
	}

	.post-tile::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgba(15, 13, 11, 0) 45%, rgba(15, 13, 11, 0.4));
		opacity: 0;
		transition: opacity 0.6s var(--ease-premium);
		pointer-events: none;
	}

	.post-badge {
		position: absolute;
		top: 0.5rem;
		right: 0.5rem;
		z-index: 1;
		display: grid;
		place-items: center;
		width: 1.75rem;
		height: 1.75rem;
		border-radius: 999px;
		background: rgba(15, 13, 11, 0.45);
		color: var(--color-cream);
		backdrop-filter: blur(6px);
	}

	@media (min-width: 768px) {
		.post-grid {
			gap: 6px;
		}

		.post-tile {
			border-radius: 0.6rem;
		}

		.post-badge {
			top: 0.75rem;
			right: 0.75rem;
			width: 2rem;
			height: 2rem;
		}
	}

	@media (hover: hover) and (pointer: fine) {
		.post-tile:hover .post-img {
			scale: 1.045;
		}

		.post-tile:hover::after {
			opacity: 1;
		}
	}

	/* ---------- Viewer (native <dialog> in the top layer) ---------- */
	.viewer {
		width: 100%;
		max-width: none;
		height: 100%;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--color-cream);
		overflow: hidden;
		overscroll-behavior: contain;
	}

	.viewer[open] {
		display: grid;
		grid-template-rows: auto minmax(0, 1fr) auto;
		animation: viewer-in 0.45s var(--ease-premium);
	}

	.viewer.is-closing {
		animation: viewer-out 0.26s ease forwards;
	}

	.viewer::backdrop {
		background: rgba(12, 10, 8, 0.94);
		backdrop-filter: blur(10px);
	}

	.viewer-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-top: calc(env(safe-area-inset-top) + 0.9rem);
		padding-bottom: 0.9rem;
		padding-left: max(1rem, env(safe-area-inset-left));
		padding-right: max(1rem, env(safe-area-inset-right));
	}

	.viewer-count {
		font-family: var(--font-display);
		font-size: 0.95rem;
		font-style: italic;
		color: var(--color-cream-dim);
	}

	.viewer-btn {
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 999px;
		border: 1px solid rgba(246, 239, 225, 0.18);
		background: rgba(28, 22, 17, 0.6);
		color: var(--color-cream);
		transition:
			background-color 0.4s var(--ease-premium),
			border-color 0.4s var(--ease-premium),
			color 0.4s var(--ease-premium);
	}

	.viewer-btn:active {
		background: var(--color-clay);
		border-color: var(--color-clay);
		color: var(--color-ink);
	}

	@media (hover: hover) and (pointer: fine) {
		.viewer-btn:hover {
			background: var(--color-clay);
			border-color: var(--color-clay);
			color: var(--color-ink);
		}
	}

	.viewer-stage {
		position: relative;
		display: grid;
		place-items: center;
		min-height: 0;
		padding-inline: 0.75rem;
		touch-action: none;
		user-select: none;
	}

	.viewer-figure {
		display: grid;
		place-items: center;
		width: 100%;
		height: 100%;
		min-height: 0;
		margin: 0;
		transition:
			translate 0.35s var(--ease-premium),
			opacity 0.35s var(--ease-premium);
	}

	.viewer-figure.is-dragging {
		transition: none;
	}

	.viewer-media {
		display: block;
		max-width: min(100%, 68rem);
		/* Screen height minus the top bar and dots, so tall photos always fit whole. */
		max-height: calc(100dvh - 8.75rem - env(safe-area-inset-top) - env(safe-area-inset-bottom));
		width: auto;
		height: auto;
		border-radius: 0.9rem;
		object-fit: contain;
		background: var(--color-panel);
		box-shadow: 0 40px 100px -30px rgba(0, 0, 0, 0.8);
	}

	.viewer-media[hidden] {
		display: none;
	}

	.viewer-figure.enter-next {
		animation: slide-from-right 0.5s var(--ease-premium);
	}

	.viewer-figure.enter-prev {
		animation: slide-from-left 0.5s var(--ease-premium);
	}

	.viewer-nav {
		position: absolute;
		top: 50%;
		z-index: 2;
		translate: 0 -50%;
	}

	.viewer-nav[hidden] {
		display: none;
	}

	.viewer-dots {
		display: flex;
		justify-content: center;
		gap: 0.4rem;
		padding: 1.1rem 1rem calc(env(safe-area-inset-bottom) + 1.25rem);
	}

	.viewer-dot {
		width: 0.4rem;
		height: 0.4rem;
		border-radius: 999px;
		background: rgba(246, 239, 225, 0.25);
		transition:
			background-color 0.4s var(--ease-premium),
			width 0.4s var(--ease-premium);
	}

	.viewer-dot.is-active {
		width: 1.1rem;
		background: var(--color-clay-light);
	}

	/* Phones: swipe is the main gesture, so the arrows shrink and sit over the photo's edges. */
	@media (max-width: 767px) {
		.viewer-nav {
			width: 2.4rem;
			height: 2.4rem;
			background: rgba(15, 13, 11, 0.5);
			backdrop-filter: blur(6px);
		}

		.viewer-prev {
			left: 1.25rem;
		}

		.viewer-next {
			right: 1.25rem;
		}
	}

	@media (min-width: 768px) {
		.viewer-stage {
			padding-inline: 5.5rem;
		}

		.viewer-prev {
			left: 1.5rem;
		}

		.viewer-next {
			right: 1.5rem;
		}

		.viewer-bar {
			padding-inline: 1.5rem;
		}
	}

	@keyframes viewer-in {
		from {
			opacity: 0;
			scale: 0.97;
		}
	}

	@keyframes viewer-out {
		to {
			opacity: 0;
			scale: 0.98;
		}
	}

	@keyframes slide-from-right {
		from {
			opacity: 0;
			translate: 2.5rem 0;
		}
	}

	@keyframes slide-from-left {
		from {
			opacity: 0;
			translate: -2.5rem 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.viewer[open],
		.viewer.is-closing,
		.viewer-figure.enter-next,
		.viewer-figure.enter-prev {
			animation: none;
		}
	}
</style>
