---
import { icons, type IconName } from './icons';

interface Props {
	name: IconName;
	class?: string;
	strokeWidth?: number;
}

const { name, class: className = 'h-5 w-5', strokeWidth = 1.6 } = Astro.props;
---

<svg
	viewBox="0 0 24 24"
	class={className}
	fill="none"
	stroke="currentColor"
	stroke-width={strokeWidth}
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"
	set:html={icons[name]}
/>
