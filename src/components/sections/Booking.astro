---
/* DOM order is the phone order (heading, form, reassurances) so a CTA tap lands next to the form. */
import BookingForm from '../booking/BookingForm.astro';
import Icon from '../ui/Icon.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { instagramHandle, mailHref, site, telHref } from '../../config/site';

const dmUrl = `https://ig.me/m/${site.contact.instagram}`;
const { responseTime, calendlyUrl } = site.booking;

const lede = `Tell us the basics — it takes about a minute. We’ll get back to you about your date${
	responseTime ? `, usually within ${responseTime}` : ''
}.`;

const reassurances = [
	{ icon: 'sparkle', text: 'A setup tailored to your event' },
	{ icon: 'check', text: 'Sending a request commits you to nothing' },
	{ icon: 'coconut', text: 'Styled and served on site by The Coco Shack' },
] as const;
---

<section id="contact" class="section border-t border-cream/10" aria-labelledby="contact-title" data-hide-mobile-cta>
	<div class="container-page grid gap-y-10 lg:grid-cols-12 lg:grid-rows-[auto_1fr] lg:gap-x-14 lg:gap-y-0">
		<div class="lg:col-span-5 lg:row-start-1">
			<SectionHeading eyebrow="07 — Book your event" title="Let’s plan *your bar.*" titleId="contact-title" lede={lede} />
		</div>

		<div class="lg:col-span-7 lg:col-start-6 lg:row-span-2 lg:row-start-1" data-reveal>
			<BookingForm />
		</div>

		<div class="lg:col-span-5 lg:row-start-2 lg:mt-9 lg:self-start">
			<ul class="space-y-4" data-reveal>
				{
					reassurances.map((item) => (
						<li class="flex items-center gap-3.5 text-[0.97rem] text-cream-dim">
							<span class="grid h-9 w-9 shrink-0 place-items-center rounded-full border border-cream/12 text-clay-light">
								<Icon name={item.icon} class="h-4 w-4" />
							</span>
							{item.text}
						</li>
					))
				}
			</ul>

			<div class="mt-9 space-y-2.5 border-t border-cream/10 pt-7 text-sm text-cream-dim" data-reveal>
				<p class="text-[0.7rem] font-bold uppercase tracking-[0.22em] text-muted">Rather talk first?</p>
				<p class="flex flex-wrap gap-x-6 gap-y-2.5 font-semibold text-cream">
					{
						telHref && (
							<a href={telHref} class="direct-link">
								<Icon name="phone" class="h-4 w-4 text-clay-light" /> {site.contact.phone}
							</a>
						)
					}
					{
						calendlyUrl && (
							<a href={calendlyUrl} data-calendly class="direct-link">
								<Icon name="calendar" class="h-4 w-4 text-clay-light" /> Book a 15-minute call
							</a>
						)
					}
					{
						mailHref && (
							<a href={mailHref} class="direct-link">
								<Icon name="mail" class="h-4 w-4 text-clay-light" /> {site.contact.email}
							</a>
						)
					}
					<a href={dmUrl} target="_blank" rel="noopener noreferrer" class="direct-link">
						<Icon name="instagram" class="h-4 w-4 text-clay-light" /> {instagramHandle}
					</a>
				</p>
			</div>
		</div>
	</div>
</section>

<style>
	.direct-link {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		min-height: 2.25rem;
		transition: color 0.3s ease;
	}

	.direct-link:hover {
		color: var(--color-clay-light);
	}
</style>
