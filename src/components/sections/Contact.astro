---
/**
 * Direct-contact CTA — no booking form here. The multi-step form lives on the
 * `booking-form-upcharge` git branch (removed from the live site as a scoped upsell);
 * every "Book Your Event" button site-wide points at this section's #contact id.
 * DOM order is the phone order (heading, contact cards, reassurances) so the number is
 * on screen the moment a CTA lands here; on lg the grid places reassurances under the heading.
 */
import Icon from '../ui/Icon.astro';
import type { IconName } from '../ui/icons';
import SectionHeading from '../ui/SectionHeading.astro';
import { instagramHandle, mailHref, site, telHref } from '../../config/site';

const { responseTime, calendlyUrl } = site.booking;

const lede = `Call, email or send a DM with your date and guest count — we’ll get back to you with availability and a quote${
	responseTime ? `, usually within ${responseTime}` : ''
}.`;

const reassurances = [
	{ icon: 'sparkle', text: 'A quote tailored to your event' },
	{ icon: 'check', text: 'Reaching out commits you to nothing' },
	{ icon: 'coconut', text: 'Styled and served on site by The Coco Shack' },
] as const;

const dmUrl = `https://ig.me/m/${site.contact.instagram}`;

type ContactMethod = {
	href: string;
	icon: IconName;
	label: string;
	value: string;
	external?: boolean;
	calendly?: boolean;
	/** Long values (the email address) get a full-width card on sm+ so they stay on one line. */
	wide?: boolean;
	/** Let the value wrap after the "@" instead of splitting mid-word on very narrow screens. */
	breakAfterAt?: boolean;
};

const contactMethods = [
	telHref && { href: telHref, icon: 'phone', label: 'Call', value: site.contact.phone },
	{ href: dmUrl, icon: 'instagram', label: 'Instagram DM', value: instagramHandle, external: true },
	mailHref && { href: mailHref, icon: 'mail', label: 'Email', value: site.contact.email, wide: true, breakAfterAt: true },
	calendlyUrl && { href: calendlyUrl, icon: 'calendar', label: 'Book a call', value: 'Pick a time that works', calendly: true, wide: true },
].filter(Boolean) as ContactMethod[];
---

<section id="contact" class="section border-t border-cream/10" aria-labelledby="contact-title" data-hide-mobile-cta>
	<div class="container-page grid gap-y-10 lg:grid-cols-12 lg:gap-x-14 lg:gap-y-0">
		<div class="lg:col-span-5 lg:row-start-1">
			<SectionHeading eyebrow="07 — Get in touch" title="Let’s talk about *your event.*" titleId="contact-title" lede={lede} />
		</div>

		<div class="grid grid-cols-1 gap-3.5 sm:grid-cols-2 lg:col-span-7 lg:col-start-6 lg:row-span-2 lg:row-start-1 lg:self-start lg:pt-2" data-reveal>
			{
				contactMethods.map((method) => (
					<a
						href={method.href}
						class:list={['spotlight contact-card', method.wide && 'sm:col-span-2']}
						target={method.external ? '_blank' : undefined}
						rel={method.external ? 'noopener noreferrer' : undefined}
						data-calendly={method.calendly ? true : undefined}
					>
						<span class="contact-card-icon">
							<Icon name={method.icon} class="h-5 w-5" strokeWidth={1.7} />
						</span>
						<span class="mt-5 text-[0.7rem] font-bold uppercase tracking-[0.2em] text-clay-light">{method.label}</span>
						<span class="contact-card-value">
							{method.breakAfterAt ? method.value.split('@').flatMap((part, i) => (i === 0 ? [part, '@', <wbr />] : [part])) : method.value}
						</span>
					</a>
				))
			}
		</div>

		<div class="lg:col-span-5 lg:row-start-2 lg:mt-9">
			<ul class="space-y-4" data-reveal>
				{
					reassurances.map((item) => (
						<li class="flex items-center gap-3.5 text-[0.97rem] text-cream-dim">
							<span class="grid h-9 w-9 shrink-0 place-items-center rounded-full border border-cream/12 text-clay-light">
								<Icon name={item.icon} class="h-4 w-4" />
							</span>
							{item.text}
						</li>
					))
				}
			</ul>

			{
				site.pricing.startingFrom && (
					<p class="mt-8 text-sm text-cream-dim" data-reveal>
						Most events start from <strong class="font-semibold text-cream">{site.pricing.startingFrom}</strong>.
					</p>
				)
			}
		</div>
	</div>
</section>

<style>
	.contact-card {
		position: relative;
		isolation: isolate;
		display: flex;
		flex-direction: column;
		border-radius: 1.4rem;
		border: 1px solid rgba(246, 239, 225, 0.14);
		background: var(--color-panel);
		/* Grid items default to min-width:auto, which let a long unbreakable value (the email) hold the whole
		   column open and push the card past the page gutter — the page's overflow:clip then hid it silently. */
		min-width: 0;
		padding: 1.25rem;
		transition:
			border-color 0.4s var(--ease-premium),
			translate 0.4s var(--ease-premium);
	}

	@media (min-width: 640px) {
		.contact-card {
			padding: 1.5rem;
		}
	}

	.contact-card-value {
		margin-top: 0.375rem;
		font-family: var(--font-display);
		font-size: 1.1rem;
		font-weight: 600;
		line-height: 1.3;
		color: var(--color-cream);
		overflow-wrap: anywhere;
	}

	@media (min-width: 640px) {
		.contact-card-value {
			font-size: 1.2rem;
		}
	}

	.contact-card:active {
		translate: 0 2px;
	}

	@media (hover: hover) and (pointer: fine) {
		.contact-card:hover {
			border-color: rgba(193, 128, 76, 0.5);
			translate: 0 -3px;
		}
	}

	.contact-card-icon {
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		flex-shrink: 0;
		border-radius: 999px;
		border: 1px solid rgba(246, 239, 225, 0.14);
		background: var(--color-ink);
		color: var(--color-clay-light);
	}
</style>
