---
import Icon from '../ui/Icon.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { services } from '../../data/content';
---

<section id="services" class="section" aria-labelledby="services-title">
	<div class="container-page">
		<SectionHeading
			eyebrow="01 — What we pour"
			title="Start with the coconuts. *Add what fits.*"
			titleId="services-title"
			lede="The live coconut bar is the centrepiece — pair it with sugarcane juice, signature drinks or a coffee and tea bar."
		/>

		<div class="services-rail mt-12 md:mt-16">
			{
				services.map((service, i) => (
					<div class="service-slide" data-reveal>
						<article class="spotlight group flex h-full flex-col rounded-[1.6rem] border border-cream/10 bg-panel p-7 transition-[border-color,translate] duration-500 hover:-translate-y-1 hover:border-clay/40 md:p-8">
							<div class="flex items-start justify-between">
								<div class="grid h-14 w-14 place-items-center rounded-2xl border border-cream/10 bg-ink text-clay-light transition-transform duration-700 group-hover:-rotate-6 group-hover:scale-105">
									<Icon name={service.icon} class="h-7 w-7" strokeWidth={1.5} />
								</div>
								<span class="font-display text-sm italic text-muted">0{i + 1}</span>
							</div>
							<p class="mt-8 text-[0.7rem] font-bold uppercase tracking-[0.22em] text-clay-light">{service.kicker}</p>
							<h3 class="mt-2 font-display text-[1.6rem] font-semibold leading-tight text-cream">{service.title}</h3>
							<p class="mt-3 text-[0.95rem] leading-relaxed text-cream-dim">{service.desc}</p>
							<div class="mt-auto pt-6">
								<ul class="space-y-2.5 border-t border-cream/10 pt-6">
									{service.points.map((point) => (
										<li class="flex items-start gap-2.5 text-sm text-cream-dim">
											<Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-clay-light" strokeWidth={2.2} />
											{point}
										</li>
									))}
								</ul>
							</div>
						</article>
					</div>
				))
			}
		</div>
		<p class="mt-5 flex items-center gap-2 text-xs font-semibold text-muted md:hidden" aria-hidden="true">
			Swipe to see all four <Icon name="arrow" class="h-3.5 w-3.5" />
		</p>
	</div>
</section>

<style>
	/* Phones: a swipeable rail with the next card peeking in. Tablet/desktop: a grid. */
	.services-rail {
		display: flex;
		gap: 0.9rem;
		margin-inline: -1.25rem;
		padding-inline: 1.25rem;
		scroll-padding-inline: 1.25rem;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
		-webkit-overflow-scrolling: touch;
		padding-bottom: 0.25rem;
	}

	.services-rail::-webkit-scrollbar {
		display: none;
	}

	.service-slide {
		flex: 0 0 min(84%, 22rem);
		scroll-snap-align: start;
	}

	@media (min-width: 768px) {
		.services-rail {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 1.25rem;
			margin-inline: 0;
			padding-inline: 0;
			overflow: visible;
		}
	}

	@media (min-width: 1200px) {
		.services-rail {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}
</style>
