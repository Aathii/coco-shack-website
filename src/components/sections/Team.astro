---
/**
 * The people behind the bar, below Andrew's founder section. Each card shows a headshot when one
 * exists in src/assets/team/ (named `<slug>.jpg|jpeg|png|webp`, slugs live in `team` in
 * src/data/content.ts) and a monogram until then. Unnumbered, like OwnerCarousel: a supporting beat.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import SectionHeading from '../ui/SectionHeading.astro';
import { team } from '../../data/content';

const headshots = import.meta.glob<{ default: ImageMetadata }>('../../assets/team/*.{jpg,jpeg,png,webp}', { eager: true });
const photoFor = (slug: string) =>
	Object.entries(headshots).find(([path]) => path.split('/').pop()?.replace(/\.[^.]+$/, '') === slug)?.[1].default;
const initialsFor = (name: string) => {
	const words = name.split(' ');
	return `${words[0][0]}${words[words.length - 1][0]}`;
};
---

<section id="meet-the-team" class="section border-t border-cream/10" aria-labelledby="meet-the-team-title">
	<div class="container-page">
		<SectionHeading eyebrow="The people" title="Meet the *team.*" titleId="meet-the-team-title" align="center" />

		<ul role="list" class="mx-auto mt-12 grid max-w-5xl grid-cols-2 gap-x-4 gap-y-10 sm:gap-x-6 md:mt-16 lg:grid-cols-4 lg:gap-x-8">
			{
				team.map((person) => {
					const photo = photoFor(person.slug);
					return (
						<li data-reveal>
							<div class="relative aspect-[4/5] overflow-hidden rounded-[1.6rem] border border-cream/10 bg-panel">
								{photo ? (
									<Image
										src={photo}
										alt={`${person.name}, ${person.role}`}
										widths={[320, 480, 640]}
										sizes="(min-width: 1024px) 240px, 45vw"
										quality={82}
										loading="lazy"
										class="h-full w-full object-cover object-top"
									/>
								) : (
									<div class="monogram grid h-full w-full place-items-center" aria-hidden="true">
										<span class="font-display text-[clamp(2.75rem,9vw,3.75rem)] font-medium italic tracking-tight text-clay-light">
											{initialsFor(person.name)}
										</span>
									</div>
								)}
							</div>
							<h3 class="mt-5 text-center font-display text-[1.2rem] font-semibold leading-tight text-cream md:text-[1.35rem]">{person.name}</h3>
							<p class="mt-2 text-center text-[0.68rem] font-bold uppercase leading-snug tracking-[0.2em] text-clay-light">{person.role}</p>
						</li>
					);
				})
			}
		</ul>
	</div>
</section>

<style>
	.monogram {
		background:
			radial-gradient(circle at 50% 38%, rgba(193, 128, 76, 0.2), transparent 62%),
			linear-gradient(160deg, var(--color-panel-2), var(--color-panel));
	}
</style>
