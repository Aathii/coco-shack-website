---
import Icon from '../ui/Icon.astro';
import PhotoCrop from '../ui/PhotoCrop.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { instagramUrl } from '../../config/site';
---

<section id="setup" class="section border-t border-cream/10" aria-labelledby="setup-title">
	<div class="container-page grid gap-12 lg:grid-cols-12 lg:gap-12">
		<div class="lg:sticky lg:top-28 lg:col-span-5 lg:self-start lg:pt-6">
			<SectionHeading
				eyebrow="02 — The setup"
				title="Styled to your event, *down to the crate.*"
				titleId="setup-title"
				lede="Rattan lanterns, fresh fronds, crates of coconuts and our signature board — every station is built to look as good in photos as it tastes."
			/>
			<div class="mt-8" data-reveal>
				<a
					href={instagramUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="link-line inline-flex items-center gap-2 text-sm font-semibold text-cream-dim transition-colors hover:text-cream"
				>
					<Icon name="instagram" class="h-4 w-4 text-clay-light" />
					More setups on Instagram
					<Icon name="arrow-up-right" class="h-3.5 w-3.5" />
				</a>
			</div>
		</div>

		<div class="grid grid-cols-2 gap-3 sm:gap-4 lg:col-span-7">
			<figure class="col-span-2">
				<PhotoCrop
					cx={0.56}
					cy={0.68}
					cw={0.62}
					aspect={1.35}
					alt="The full Coco Shack station: signature board, dried palms, rattan lanterns and coconut crates"
					class="rounded-[1.4rem]"
				/>
				<figcaption class="mt-3 flex gap-3 text-xs font-semibold uppercase tracking-[0.18em] text-muted">
					<span class="text-clay-light">01</span> The full station
				</figcaption>
			</figure>
			<figure>
				<PhotoCrop cx={0.86} cy={0.7} cw={0.3} aspect={0.8} alt="Fresh young coconuts stacked in wooden crates" class="rounded-[1.2rem]" />
				<figcaption class="mt-3 flex gap-3 text-xs font-semibold uppercase tracking-[0.18em] text-muted">
					<span class="text-clay-light">02</span> Cut to order
				</figcaption>
			</figure>
			<figure>
				<PhotoCrop cx={0.36} cy={0.6} cw={0.36} aspect={0.8} alt="Dried pampas grass and rattan lanterns styling the bar" class="rounded-[1.2rem]" />
				<figcaption class="mt-3 flex gap-3 text-xs font-semibold uppercase tracking-[0.18em] text-muted">
					<span class="text-clay-light">03</span> Styled on site
				</figcaption>
			</figure>
		</div>
	</div>
</section>
