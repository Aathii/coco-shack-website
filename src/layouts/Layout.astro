---
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@fontsource-variable/manrope/index.css';
import 'lenis/dist/lenis.css';
import '../styles/global.css';
import frauncesFont from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';
import manropeFont from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import Preloader from '../components/ui/Preloader.astro';
import { site, instagramUrl } from '../config/site';
import { services } from '../data/content';

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
}

const {
	title = `${site.name} | Live Coconut Bar for Events in Toronto & the GTA`,
	description = site.description,
	noindex = false,
} = Astro.props;

const siteUrl = Astro.site ?? new URL(site.url);
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = new URL(`${import.meta.env.BASE_URL}og-image.jpg`, siteUrl).href;

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'FoodEstablishment',
	'@id': `${siteUrl.href}#business`,
	name: site.name,
	slogan: site.tagline,
	description: site.description,
	url: siteUrl.href,
	image: ogImageUrl,
	logo: new URL(`${import.meta.env.BASE_URL}icon-512.png`, siteUrl).href,
	servesCuisine: ['Fresh coconut water', 'Mocktails', 'Cocktails'],
	address: {
		'@type': 'PostalAddress',
		addressLocality: site.location.city,
		addressRegion: site.location.region,
		addressCountry: site.location.country,
	},
	areaServed: site.location.serviceArea.map((name) => ({ '@type': 'City', name })),
	sameAs: [instagramUrl],
	...(site.contact.phone ? { telephone: site.contact.phone } : {}),
	...(site.contact.email ? { email: site.contact.email } : {}),
	hasOfferCatalog: {
		'@type': 'OfferCatalog',
		name: 'Live beverage stations',
		itemListElement: services.map((s) => ({
			'@type': 'Offer',
			itemOffered: { '@type': 'Service', name: s.title, description: s.desc },
		})),
	},
};
---

<!doctype html>
<html lang="en-CA">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<script is:inline>document.documentElement.classList.add('js');</script>
		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex" />}
		<link rel="canonical" href={canonicalUrl} />
		<meta name="theme-color" content="#0f0d0b" />
		<meta name="color-scheme" content="dark" />

		<link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} sizes="32x32" />
		<link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
		<link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
		<link rel="manifest" href={`${import.meta.env.BASE_URL}site.webmanifest`} />

		<link rel="preload" href={frauncesFont} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={manropeFont} as="font" type="font/woff2" crossorigin />

		<meta property="og:type" content="website" />
		<meta property="og:locale" content="en_CA" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="The Coco Shack's live coconut bar set up at an event" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />

		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body>
		<!-- "Back to top" target; receives focus after the jump, so it must not be aria-hidden. -->
		<div id="top" class="absolute top-0 h-px w-px"></div>
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-clay focus:px-5 focus:py-3 focus:text-sm focus:font-bold focus:text-ink"
		>
			Skip to content
		</a>

		<Preloader />

		<slot />

		<div class="grain" aria-hidden="true"></div>

		<script>
			import '../scripts/main';
		</script>
	</body>
</html>
